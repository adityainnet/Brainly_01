# AI Service Configuration
PORT=8000
HOST=0.0.0.0

# Embedding Configuration
EMBEDDING_PROVIDER=tfidf   # Options: tfidf, sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2

# LLM Configuration
LLM_PROVIDER=ollama         # Options: ollama, template_fallback
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2
LLM_TIMEOUT=15.0

# Retrieval & Search Thresholds
DEFAULT_RESULT_LIMIT=10
SIMILARITY_THRESHOLD=0.15

# Dataset Paths
DATASET_PATH=./data/sample_tweets.csv
RELATIONSHIPS_PATH=./data/tweet_relationships.csv
INSIGHTS_PATH=./data/insight_examples.jsonl
